# Postgres en Neon — https://neon.tech (Dashboard → Connection string → Pooled)
DATABASE_URL=postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# TMDB — https://www.themoviedb.org/settings/api (plan Developer, gratis)
# Es el "Token de acceso de lectura" (v4), no la API Key v3: se manda como Bearer.
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_: quedaría expuesto en el bundle del cliente.
TMDB_ACCESS_TOKEN=

# Firma de la cookie de participante. Generar con:  openssl rand -base64 32
SESSION_SECRET=

# Base pública de las imágenes de TMDB (esta sí es pública)
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
